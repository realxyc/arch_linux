{
    "app_config": {
        "audio_config": {
            "audio": "pipewire"
        },
        "bluetooth_config": {
            "enabled": true
        },
        "firewall_config": {
            "firewall": "firewalld"
        },
        "power_management_config": {
            "power_management": "power-profiles-daemon"
        },
        "print_service_config": {
            "enabled": true
        }
    },
    "archinstall_language": "English",
    "auth_config": {},
    "bootloader_config": {
        "bootloader": "Refind",
        "removable": false,
        "uki": true
    },
    "custom_commands": [],
    "disk_config": {
        "config_type": "pre_mounted_config",
        "mountpoint": "/mnt"
    },
    "hostname": "archlinux",
    "kernels": [
        "linux"
    ],
    "locale_config": {
        "console_font": "default8x16",
        "kb_layout": "us",
        "sys_enc": "UTF-8",
        "sys_lang": "en_US.UTF-8"
    },
    "network_config": {
        "type": "nm"
    },
    "ntp": true,
    "packages": [
        "btop",
        "curl",
        "fastfetch",
        "fuse3",
        "git",
        "github-cli",
        "nano",
        "ntfs-3g",
        "wget"
    ],
    "pacman_config": {
        "color": true,
        "parallel_downloads": 5
    },
    "profile_config": {
        "gfx_driver": null,
        "greeter": null,
        "profile": {
            "custom_settings": {},
            "details": [],
            "main": "Minimal"
        }
    },
    "script": null,
    "services": [],
    "swap": {
        "algorithm": "zstd",
        "enabled": true
    },
    "timezone": "Asia/Kolkata",
    "version": "4.4"
}
